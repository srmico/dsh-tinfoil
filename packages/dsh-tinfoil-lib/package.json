{
  "name": "@srmico/dsh-tinfoil-lib",
  "version": "0.1.1-rc.1",
  "private": true,
  "description": "Internal shared source for the Tinfoil plugins for DeepSeek Harness; bundled into each plugin at build time and not published",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srmico/dsh-tinfoil.git",
    "directory": "packages/dsh-tinfoil-lib"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "engines": {
    "node": "^24.22.1 || >=26.12.1",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "tinfoil": "^1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
