{
  "name": "@srmico/dsh-tinfoil-verification",
  "version": "0.1.0",
  "description": "Tinfoil attestation registry and verification center for the DeepSeek Harness Web UI",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srmico/dsh-tinfoil.git",
    "directory": "packages/dsh-tinfoil-verification"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry": {
      "types": "./lib/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "LICENSE",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": "^24.22.1 || >=26.12.1",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "tinfoil": "^1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@srmico/dsh-tinfoil-lib": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "node --check client.js && tsc -p tsconfig.json --noEmit && tsdown",
    "typecheck": "node --check client.js && tsc -p tsconfig.json --noEmit"
  }
}
