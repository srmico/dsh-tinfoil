# Optional: only needed for VLM-backed modes (text, vision, vlm).
TINFOIL_API_KEY=

# Host port for the conversion API. Bound to 127.0.0.1 in docker-compose.yml.
DOC_UPLOAD_PORT=5000

# Tinfoil VLM used by OCR modes.
VLM_MODEL=gemma4-31b

# Local resource limits. Raise these for unusually large PDFs.
DOC_ROUTER_MEMORY=2g
DOC_ROUTER_CPUS=2
DOC_PARSER_MEMORY=2g
DOC_PARSER_CPUS=2
